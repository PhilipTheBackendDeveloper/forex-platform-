# Copy to .env.local. Never commit real secrets.
# Public base URL (used for metadata, canonical URLs, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "true" ONLY on the client-approved production deployment.
NEXT_PUBLIC_ALLOW_INDEXING=false

